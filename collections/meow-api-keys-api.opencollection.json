{
  "opencollection": "1.0.0",
  "info": {
    "name": "Meow Accounts API Keys API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Accessible Entities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/api-keys/accessible-entities",
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns the entities your API key can access, with their IDs and names, so\nyou know which entity ID to pass in the `x-entity-id` header."
        },
        {
          "info": {
            "name": "Get Current API Key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/api-keys/current",
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns metadata about the API key used for the current request, including\nits type and scopes."
        }
      ]
    }
  ],
  "bundled": true
}