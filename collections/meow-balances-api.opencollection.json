{
  "opencollection": "1.0.0",
  "info": {
    "name": "Meow Accounts Balances API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Balances",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Balances for an Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/accounts/:account_id/balances",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              },
              {
                "name": "startTime",
                "value": "",
                "type": "query",
                "description": "Start time for filtering balances, in ISO 8601 format. Also accepts `start_date` for backwards compatibility."
              },
              {
                "name": "endTime",
                "value": "",
                "type": "query",
                "description": "End time for filtering balances, in ISO 8601 format. Also accepts `end_date` for backwards compatibility."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of balances for a specified account."
        }
      ]
    }
  ],
  "bundled": true
}