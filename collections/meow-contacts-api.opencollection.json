{
  "opencollection": "1.0.0",
  "info": {
    "name": "Meow Accounts Contacts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contacts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/contacts",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "nickname_query",
                "value": "",
                "type": "query",
                "description": "Optional filter to search contacts by nickname."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Opaque offset identifier for pagination. Use the nextOffset from a previous response."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns a paginated list of contacts, ordered by nickname. Use the `limit` and `offset` query parameters to page through results."
        },
        {
          "info": {
            "name": "Create Contact",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.meow.com/v1/contacts",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new contact with either ACH, wire, or check payment details or a USDC crypto address."
        },
        {
          "info": {
            "name": "Get Contact",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/contacts/:contact_id",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "contact_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns details of a specific contact."
        },
        {
          "info": {
            "name": "Update Contact",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.meow.com/v1/contacts/:contact_id",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "contact_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the contact."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Updates an existing contact and optionally adds new payment methods."
        },
        {
          "info": {
            "name": "Delete Contact",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.meow.com/v1/contacts/:contact_id",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "contact_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the contact."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Deletes a contact."
        }
      ]
    }
  ],
  "bundled": true
}