{
  "opencollection": "1.0.0",
  "info": {
    "name": "Meow Accounts Invoices API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Invoices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Invoices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/billing/invoices",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Lists all invoices."
        },
        {
          "info": {
            "name": "Create Invoice",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.meow.com/v1/billing/invoices",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new invoice."
        },
        {
          "info": {
            "name": "Get Invoice",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/billing/invoices/:invoice_id",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Gets an invoice by ID."
        },
        {
          "info": {
            "name": "Download Invoice PDF",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/billing/invoices/:invoice_id/download",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the invoice to download."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Downloads an invoice as a PDF file."
        }
      ]
    }
  ],
  "bundled": true
}