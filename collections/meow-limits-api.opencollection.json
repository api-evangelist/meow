{
  "opencollection": "1.0.0",
  "info": {
    "name": "Meow Accounts Limits API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Limits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Daily Withdrawal Limit",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/limits/daily-withdrawal",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns your current daily withdrawal limit, the highest you can raise it to, and how much you have withdrawn and can still withdraw today."
        },
        {
          "info": {
            "name": "Set Daily Withdrawal Limit",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.meow.com/v1/limits/daily-withdrawal",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Sets the most that can be withdrawn from your accounts in a single day across all transfer types. Must be a whole dollar amount from 0 up to the maximum set for your entity. Set it to 0 to block all outbound transfers while you collect funds, then raise it when you are ready to pay out."
        }
      ]
    }
  ],
  "bundled": true
}