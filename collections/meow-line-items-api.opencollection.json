{
  "opencollection": "1.0.0",
  "info": {
    "name": "Meow Accounts Line Items API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Line Items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Invoice Line Items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/billing/invoices/:invoice_id/line-items",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns all line items associated with a specific invoice."
        },
        {
          "info": {
            "name": "Get Invoice Line Item",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/billing/invoices/:invoice_id/line-items/:line_item_id",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "line_item_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns a specific line item by ID for a given invoice."
        }
      ]
    }
  ],
  "bundled": true
}