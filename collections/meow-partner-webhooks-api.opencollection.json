{
  "opencollection": "1.0.0",
  "info": {
    "name": "Meow Accounts Partner Webhooks API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Partner Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Partner Webhook Subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/partner/webhooks/subscriptions",
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns your partner webhook subscriptions."
        },
        {
          "info": {
            "name": "Create Partner Webhook Subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.meow.com/v1/partner/webhooks/subscriptions",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a partner webhook subscription and returns it along with the signing secret. The secret is returned only once, so store it now to verify delivery signatures."
        },
        {
          "info": {
            "name": "Update Partner Webhook Subscription",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.meow.com/v1/partner/webhooks/subscriptions/:subscription_id",
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Updates a partner webhook subscription. Returns the updated subscription, including a new signing secret when you request a rotation."
        },
        {
          "info": {
            "name": "Delete Partner Webhook Subscription",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.meow.com/v1/partner/webhooks/subscriptions/:subscription_id",
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Deletes a partner webhook subscription."
        },
        {
          "info": {
            "name": "Send Test Partner Webhook Event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.meow.com/v1/partner/webhooks/subscriptions/:subscription_id/test",
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Sends a test event to a partner webhook subscription and queues it for delivery so you can verify your endpoint and signature handling."
        },
        {
          "info": {
            "name": "Redrive Partner Webhook Delivery",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.meow.com/v1/partner/webhooks/deliveries/:delivery_id/redrive",
            "params": [
              {
                "name": "delivery_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Re-queues a failed partner webhook delivery for another attempt. A delivery that already succeeded or is currently being attempted cannot be redriven."
        },
        {
          "info": {
            "name": "List Partner Webhook Delivery Attempts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/partner/webhooks/deliveries/:delivery_id/attempts",
            "params": [
              {
                "name": "delivery_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns the individual delivery attempts for a partner webhook delivery, including the response status of each attempt."
        },
        {
          "info": {
            "name": "List Partner Webhook Deliveries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/partner/webhooks/deliveries",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns your partner webhook deliveries across all subscriptions, most recent first."
        }
      ]
    }
  ],
  "bundled": true
}