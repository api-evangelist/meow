{
  "opencollection": "1.0.0",
  "info": {
    "name": "Meow Accounts Routing Numbers API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Routing Numbers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Validate Routing Number",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/routing-numbers/:routing_number",
            "params": [
              {
                "name": "routing_number",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Validates a routing number and returns bank information including name, address, and supported payment methods (ACH/Wire)."
        }
      ]
    }
  ],
  "bundled": true
}