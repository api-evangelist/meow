          "request": {
            "name": "Search Tax Forms",
            "description": {
              "content": "Returns IRS tax forms (the 1099 family) issued for the specified account. Currently supports `Tax1099Int` for bank accounts; brokerage and wallet accounts return an empty list until additional form types are exposed.",
              "type": "text/plain"
            },
