            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Opaque offset identifier for pagination. Use the nextOffset from a previous response."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of scheduled ACH transfers for a specified account."
        },
        {
          "info": {
            "name": "Create Scheduled ACH Transfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.meow.com/v1/accounts/:account_id/ach/scheduled",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new scheduled ACH transfer to an external counterparty."
        },
        {
          "info": {
            "name": "Create Wire Transfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.meow.com/v1/accounts/:account_id/wire",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new wire transfer to an external counterparty."
        },
        {
          "info": {
            "name": "Get USDC Transaction (Legacy)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/accounts/:account_id/transactions/:transaction_id",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              },
              {
                "name": "transaction_id",
                "value": "",
                "type": "path",
                "description": "The ID of the USDC transaction."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Legacy endpoint for retrieving USDC transaction details. For new integrations, use `GET /accounts/{account_id}/crypto/{transaction_id}`."
        },
        {
          "info": {
            "name": "Get Crypto Transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/accounts/:account_id/crypto/:transaction_id",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              },
              {
                "name": "transaction_id",
                "value": "",
                "type": "path",
                "description": "The ID of the crypto transaction."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns details about a crypto transaction by transaction ID, including the status of an outgoing crypto transfer after it has been initiated."
        },
        {
          "info": {
            "name": "Get Wire Transfer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meow.com/v1/accounts/:account_id/wires/:wire_transfer_id",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              },
              {
                "name": "wire_transfer_id",
                "value": "",
                "type": "path",
                "description": "The transaction group ID for the wire transfer."
