{
  "opencollection": "1.0.0",
  "info": {
    "name": "Meow Accounts Transfers API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transfers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create USDC Transaction (Legacy)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.meow.com/v1/accounts/:account_id/usdc",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Legacy endpoint for USDC transactions. Requires the `transfers:usdc:write` scope. For new integrations, use `POST /accounts/{account_id}/crypto` with `currency` in the request body."
        },
        {
          "info": {
            "name": "Create Crypto Transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.meow.com/v1/accounts/:account_id/crypto",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new crypto transaction from a specified account. The currency and network are determined automatically from the destination's payment method. Provide exactly one of `static_memo_id` or `crypto_id` to identify the destination:\n\n- **`static_memo_id`**: Use the ID from the contact's `payment_methods.static_memos` array. Required for traditional banking accounts; also supported for wallet accounts.\n- **`crypto_id`**: Use the ID from the contact's `payment_methods.crypto` array. Only suppor"
        },
        {
          "info": {
            "name": "Create Book Transfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.meow.com/v1/accounts/:account_id/book",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new internal book transfer between bank accounts."
        },
        {
          "info": {
            "name": "Create ACH Transfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.meow.com/v1/accounts/:account_id/ach",
            "headers": [
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new ACH transfer to an external counterparty."
        },
        {
          "info": {
            "name": "List Scheduled ACH Transfers",
            "type": "http"
          },
          "http": {
            "method": "GET",
