            "method": "POST",
            "url": "https://api.meow.com/v1/webhooks/subscriptions/:subscription_id/test",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              },
              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Sends a test event to a webhook subscription and queues it for delivery so you can verify your endpoint and signature handling."
        },
