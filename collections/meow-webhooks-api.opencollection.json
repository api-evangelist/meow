              {
                "name": "x-entity-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Deletes a webhook subscription. Its delivery history stays queryable so you can review past attempts."
        },
        {
          "info": {
            "name": "Send Test Webhook Event",
            "type": "http"
          },
